// 覆盖 Volantis 默认 .blur 毛玻璃样式
// 主题更新不会覆盖此文件，可在此调整透明度
// 修改 .6 为所需透明度值（0.0~1.0）

// 亮色模式 - 覆盖主题的 --color-card-a90 变量
:root
  --color-card-a90: alpha($color-card, .6)

.blur
  @supports (backdrop-filter: blur(20px))
    background: alpha($color-card, .6) !important
    backdrop-filter: saturate(200%) blur(20px)

// 暗色模式 - 手动切换
[color-scheme='dark']
  .blur
    background: alpha($color-dark-site-bg, .6) !important
  .white-box.blur
    background: alpha($color-dark-card, .6) !important

// 暗色模式 - 跟随系统
@media (prefers-color-scheme: dark)
  :root:not([color-scheme])
    .blur
      background: alpha($color-dark-site-bg, .6) !important
    .white-box.blur
      background: alpha($color-dark-card, .6) !important
